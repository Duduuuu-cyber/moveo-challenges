# Multi-stage production build for Go Kafka Producer Microservice
FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o producer-service ./cmd/producer

FROM alpine:3.19 AS runner

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/producer-service .

EXPOSE 8081

CMD ["./producer-service"]
